{
  "name": "far-recharge-server",
  "version": "1.0.0",
  "description": "Backend API for FAR (Forget About Recharge) platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "cluster": "pm2 start ecosystem.config.js --env production",
    "db:init": "node scripts/initDb.js",
    "db:sync": "node scripts/syncDb.js",
    "test:redis": "node scripts/testRedisOptimization.js",
    "test:youtube": "node scripts/testYouTubeSystem.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.js\""
  },
  "keywords": [
    "viral",
    "recharge",
    "express",
    "mysql",
    "sequelize",
    "redis"
  ],
  "author": "FAR Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^182.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "mysql2": "^3.12.0",
    "node-cron": "^4.6.0",
    "rate-limit-redis": "^4.3.1",
    "sequelize": "^6.37.5",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.21.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.2"
  }
}
